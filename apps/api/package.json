{
  "name": "@dento/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm --watch-path=src src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:contract:watch": "vitest --config vitest.contract.config.ts",
    "seed:platform": "node --env-file=.env --import tsx/esm src/scripts/seed-platform.ts",
    "seed:tenant": "node --env-file=.env --import tsx/esm src/scripts/seed-tenant.ts",
    "seed:e2e": "node --env-file=.env --import tsx/esm src/scripts/seed-e2e.ts",
    "backfill:encrypt-phi": "node --env-file=.env --import tsx/esm src/scripts/encrypt-existing-phi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@dento/shared": "workspace:*",
    "@fast-csv/format": "^5.0.8",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.6",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.3.4",
    "@payloadcms/db-mongodb": "^3.92.1",
    "@payloadcms/plugin-cloud-storage": "^3.92.1",
    "@payloadcms/richtext-lexical": "^3.92.1",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/node": "^11.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "6.5.1",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "ioredis": "6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.3.1",
    "otplib": "^13.5.0",
    "payload": "^3.92.1",
    "pino": "^10.4.0",
    "pino-axiom": "^1.0.432",
    "qrcode": "^1.5.4",
    "resend": "^6.35.0",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.4",
    "stripe": "^23.1.0",
    "twilio": "^6.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}

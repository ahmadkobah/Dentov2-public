{
  "name": "@dento/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm --watch-path=src src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:contract:watch": "vitest --config vitest.contract.config.ts",
    "seed:platform": "node --env-file=.env --import tsx/esm src/scripts/seed-platform.ts",
    "seed:tenant": "node --env-file=.env --import tsx/esm src/scripts/seed-tenant.ts",
    "seed:e2e": "node --env-file=.env --import tsx/esm src/scripts/seed-e2e.ts",
    "backfill:encrypt-phi": "node --env-file=.env --import tsx/esm src/scripts/encrypt-existing-phi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1077.0",
    "@aws-sdk/s3-request-presigner": "^3.1077.0",
    "@dento/shared": "workspace:*",
    "@fast-csv/format": "^5.0.7",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@fastify/websocket": "^11.2.0",
    "@payloadcms/db-mongodb": "^3.85.2",
    "@payloadcms/plugin-cloud-storage": "^3.85.2",
    "@payloadcms/richtext-lexical": "^3.85.2",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/node": "^10.63.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "5.79.2",
    "dayjs": "^1.11.21",
    "exceljs": "^4.4.0",
    "fastify": "^5.9.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "nanoid": "^5.1.16",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "payload": "^3.85.2",
    "pino": "^10.3.1",
    "pino-axiom": "^1.0.432",
    "qrcode": "^1.5.4",
    "resend": "^6.16.0",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "stripe": "^22.3.0",
    "twilio": "^6.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.9",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}

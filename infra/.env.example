# ─────────────────────────────────────────────────────────────────────────────
# Dento V2 — Production environment template
# Copy to /srv/dento/.env on the VM:    chmod 600 /srv/dento/.env
# Replace ALL placeholder values before starting the API.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# ── Public URLs (used in CORS + email links) ────────────────────────────────
API_URL=https://apidento.pixelws.de
ADMIN_URL=https://appdento.pixelws.de
DEVELOPER_URL=https://devdento.pixelws.de

# ── Database (MongoDB Atlas M0 — free tier) ─────────────────────────────────
# Get from https://cloud.mongodb.com → Database → Connect → Drivers (Node.js)
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/dento?retryWrites=true&w=majority

# ── Cache / Queue (Upstash Redis — free tier) ───────────────────────────────
# Get from https://console.upstash.com → Redis → Connect → Node.js
REDIS_URL=rediss://default:PASSWORD@divine-sparrow-115792.upstash.io:6379

# ── Secrets (generate with `openssl rand -hex 32`) ──────────────────────────
PAYLOAD_SECRET=__GENERATE_64_CHARS__
JWT_ACCESS_SECRET=__GENERATE_32_CHARS_MIN__
JWT_REFRESH_SECRET=__GENERATE_32_CHARS_MIN__
PLATFORM_API_KEY=__GENERATE_32_CHARS__

# ── Encryption (REQUIRED in production, must differ from each other) ────────
# Generate: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=__64_HEX_CHARS__
SEARCH_HASH_KEY=__32_PLUS_CHARS_DIFFERENT_FROM_MASTER__

# ── S3 / R2 storage (Cloudflare R2 free tier recommended) ───────────────────
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=dento-prod
S3_REGION=auto

# ── Email (SMTP — Brevo / Resend / Mailgun free tier) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@pixelws.de

# ── Observability (optional — Sentry free tier) ─────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

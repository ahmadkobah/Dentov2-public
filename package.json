{
  "name": "dento-v2",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config tests/e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --headed --config tests/e2e/playwright.config.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "verify": "turbo build lint type-check test && prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "^3.9.4",
    "tsx": "^4.22.5",
    "turbo": "2.10.2",
    "typescript": "^6",
    "typescript-eslint": "^8.62.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<0.28.1": ">=0.28.1",
      "ioredis": "^5.11.1",
      "undici@>=7.0.0 <7.24.0": ">=7.24.0",
      "socket.io-parser@<4.2.6": ">=4.2.6",
      "fast-xml-parser@>=5.0.0 <5.5.6": ">=5.5.6",
      "flatted@<3.4.2": ">=3.4.2",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "serialize-javascript@<7.0.3": ">=7.0.3",
      "immutable@<4.3.8": ">=4.3.8",
      "axios@>=1.0.0 <1.15.2": ">=1.15.2",
      "fast-jwt@<6.2.0": ">=6.2.0",
      "vitest@<4.1.0": ">=4.1.0",
      "react-router@>=7.0.0 <7.15.0": ">=7.15.0",
      "mongoose@>=8.0.0 <=8.22.0": ">=8.22.1",
      "fast-uri@<=3.1.1": ">=3.1.2",
      "tmp@<0.2.6": ">=0.2.6",
      "@babel/plugin-transform-modules-systemjs@>=7.12.0 <=7.29.3": ">=7.29.4",
      "@payloadcms/next": "^3.79.1",
      "@payloadcms/graphql": "^3.79.1",
      "@payloadcms/ui": "^3.79.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mmxc-95ch-2j7c"
      ]
    }
  }
}

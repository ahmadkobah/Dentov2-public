# ============================================================
# Dento v2 — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env files with real secrets!
# See apps/api/src/config/env.ts for the Zod schema.
# ============================================================


# ┌─────────────────────────────────────────────────────────┐
# │  1. GENERAL                                             │
# └─────────────────────────────────────────────────────────┘
NODE_ENV=development
PORT=3001


# ┌─────────────────────────────────────────────────────────┐
# │  2. DATABASE                                            │
# └─────────────────────────────────────────────────────────┘
MONGODB_URI=mongodb://localhost:27017/dento_platform
# NOTE: docker-compose maps Redis to host port 6380 (container 6379 -> host 6380).
# Use 6380 for local dev against docker-compose; 6379 only if Redis runs natively.
REDIS_URL=redis://localhost:6380


# ┌─────────────────────────────────────────────────────────┐
# │  3. AUTH & SECURITY                                     │
# └─────────────────────────────────────────────────────────┘
PAYLOAD_SECRET=change-me-to-random-32-char-string
JWT_ACCESS_SECRET=change-me-to-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-random-64-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ENCRYPTION_MASTER_KEY=change-me-to-random-64-hex-string
TOTP_ISSUER=Dento


# ┌─────────────────────────────────────────────────────────┐
# │  4. CORS & PORTAL URLS                                  │
# └─────────────────────────────────────────────────────────┘
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
ADMIN_PORTAL_URL=http://localhost:5173


# ┌─────────────────────────────────────────────────────────┐
# │  5. FILE STORAGE (Cloudflare R2 / S3)                   │
# └─────────────────────────────────────────────────────────┘
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-r2-access-key
S3_SECRET_KEY=your-r2-secret-key
S3_BUCKET=dento-uploads
S3_BACKUP_BUCKET=dento-backups
R2_PUBLIC_URL=https://cdn.dento.app


# ┌─────────────────────────────────────────────────────────┐
# │  6. EMAIL (Resend primary + SMTP fallback)              │
# └─────────────────────────────────────────────────────────┘
RESEND_API_KEY=re_xxxxxxxxxxxxx
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password


# ┌─────────────────────────────────────────────────────────┐
# │  7. SMS (Twilio)                                        │
# └─────────────────────────────────────────────────────────┘
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890


# ┌─────────────────────────────────────────────────────────┐
# │  8. WHATSAPP (Meta Business API)                        │
# └─────────────────────────────────────────────────────────┘
META_WHATSAPP_PHONE_ID=your-whatsapp-phone-id
META_WHATSAPP_TOKEN=your-whatsapp-token
# Webhook verification token (you choose this value; must match Meta dashboard).
META_WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# App Secret used to validate X-Hub-Signature-256 on inbound webhooks (required in production).
META_WHATSAPP_APP_SECRET=your-meta-app-secret


# ┌─────────────────────────────────────────────────────────┐
# │  9. WEB PUSH (VAPID)                                    │
# └─────────────────────────────────────────────────────────┘
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CONTACT_EMAIL=support@dento.app
VAPID_SUBJECT=mailto:support@dento.app


# ┌─────────────────────────────────────────────────────────┐
# │  10. PAYMENTS — Stripe (International)                  │
# └─────────────────────────────────────────────────────────┘
STRIPE_SECRET_KEY=sk_test_xxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxx


# ┌─────────────────────────────────────────────────────────┐
# │  11. PAYMENTS — Paymob (Egypt)                          │
# └─────────────────────────────────────────────────────────┘
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_CARD_INTEGRATION_ID=your-card-integration-id
PAYMOB_FAWRY_INTEGRATION_ID=your-fawry-integration-id
PAYMOB_WALLET_INTEGRATION_ID=your-wallet-integration-id
PAYMOB_VALU_INTEGRATION_ID=your-valu-integration-id
PAYMOB_IFRAME_ID=your-iframe-id
PAYMOB_HMAC_SECRET=your-paymob-hmac


# ┌─────────────────────────────────────────────────────────┐
# │  12. MONITORING                                         │
# └─────────────────────────────────────────────────────────┘
SENTRY_DSN=https://xxxxxx@sentry.io/xxxxx
AXIOM_TOKEN=xaat-xxxxxxx
AXIOM_DATASET=dento-logs


# ┌─────────────────────────────────────────────────────────┐
# │  13. INFRASTRUCTURE                                     │
# └─────────────────────────────────────────────────────────┘
TAILSCALE_API_KEY=tskey-api-xxxxxxx
TAILSCALE_TAILNET=your-tailnet-name
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
DEPLOY_WEBHOOK_SECRET=your-deploy-webhook-secret


# ┌─────────────────────────────────────────────────────────┐
# │  14. BACKUP TOOLS (optional — custom binary paths)      │
# └─────────────────────────────────────────────────────────┘
# MONGODUMP_PATH=/usr/bin/mongodump
# MONGORESTORE_PATH=/usr/bin/mongorestore


# ┌─────────────────────────────────────────────────────────┐
# │  16. FRONTEND (Vite — VITE_ prefix)                     │
# └─────────────────────────────────────────────────────────┘
VITE_API_URL=http://localhost:3001
VITE_SENTRY_DSN=https://xxxxxx@sentry.io/xxxxx
VITE_APP_VERSION=0.1.0
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key


# ┌─────────────────────────────────────────────────────────┐
# │  17. CI / BUILD (Vite build-time, not browser)          │
# └─────────────────────────────────────────────────────────┘
# ANALYZE=true
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxx
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project


# ┌─────────────────────────────────────────────────────────┐
# │  18. MIGRATION (one-time v1 → v2, optional)             │
# └─────────────────────────────────────────────────────────┘
# V1_DATABASE_URL=mongodb://localhost:27017/dento_v1
